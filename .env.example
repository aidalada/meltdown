# Server-only (set in Vercel for Production AND Preview; locally in .env.local)
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5 (team decision to switch, see SPEC 9.1)
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. low | medium | high. Default: low
ANTHROPIC_EFFORT=low
# Optional. 1 = never call the model, always use the built-in heuristic coach
MOCK_AI=0

# Public (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_YEARLY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
